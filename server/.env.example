# GEEK HELL - SERVER ENVIRONMENT VARIABLES PLACEHOLDER
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI="mongodb+srv://placeholder_user:placeholder_pass@cluster.mongodb.net/geek_hell?retryWrites=true&w=majority"

# Security & JWT
JWT_ACCESS_SECRET="placeholder_jwt_access_secret_min_32_chars"
JWT_REFRESH_SECRET="placeholder_jwt_refresh_secret_min_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"

# Cloudinary CDN
CLOUDINARY_CLOUD_NAME="placeholder_cloud_name"
CLOUDINARY_API_KEY="placeholder_api_key"
CLOUDINARY_API_SECRET="placeholder_api_secret"

# Stripe Payments
STRIPE_SECRET_KEY="sk_test_placeholder_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_webhook_secret"

# Nodemailer Email Worker
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="placeholder_user"
SMTP_PASS="placeholder_pass"
EMAIL_FROM="Geek Hell Orders <orders@geekhell.com>"
